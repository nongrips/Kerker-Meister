; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Unearth"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/main_scene="res://Scenes/Main.tscn"
config/icon="res://Art/icon/UnearthIcon256x256.png"

[autoload]

Slabs="*res://Autoload/Slabs.gd"
Random="*res://Autoload/Random.gd"
Constants="*res://Autoload/Constants.gd"
Cube="*res://Autoload/Cube.gd"
Settings="*res://Autoload/Settings.gd"
Things="*res://Autoload/Things.gd"
Nodelist="*res://Autoload/Nodelist.gd"
Utils="*res://Autoload/Utils.gd"
M="*res://Autoload/M.gd"
Slabset="*res://Autoload/Slabset.gd"
Columnset="*res://Autoload/Columnset.gd"
Version="*res://Autoload/Version.gd"
Graphics="*res://Autoload/Graphics.gd"
Names="*res://Autoload/Names.gd"

[debug]

gdscript/warnings/unused_parameter=false
gdscript/warnings/return_value_discarded=false
gdscript/warnings/integer_division=false

[display]

window/size/viewport_width=1024
window/size/viewport_height=576
window/size/borderless=true
window/dpi/allow_hidpi=true
window/energy_saving/keep_screen_on=false

[editor_plugins]

enabled=PackedStringArray("res://addons/CopyStackFrames/plugin.cfg", "res://addons/GDScriptMacros/plugin.cfg", "res://addons/IncludeOnExport/plugin.cfg", "res://addons/NodeScriptRenamer/plugin.cfg", "res://addons/SingletonScriptsShortcut/plugin.cfg", "res://addons/UnearthEditorPlugin/plugin.cfg", "res://addons/godot-plugin-refresher/plugin.cfg")

